From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mrvictory1 <108172910+mrvictory1@users.noreply.github.com>
Date: Thu, 30 Jul 2026 13:19:21 +0300
Subject: [PATCH 34/42] proton: call wine instead of preloader

wine64-preloader throws a 'bus error' while wine works
---
 proton | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/proton b/proton
index e8f18b64..18b4ec68 100755
--- a/proton
+++ b/proton
@@ -2039,7 +2039,7 @@ class Session:
             if g_proton.host_pe_arch == "x86_64-windows":
                 #run with winepreloader directly to avoid restart through start.exe
                 self.env["WINELOADERNOEXEC"] = "1"
-                argv = [g_proton.lib_dir + "/wine/x86_64-unix/wine-preloader", g_proton.lib_dir + "/wine/x86_64-unix/wine", "c:\\windows\\system32\\steam.exe"]
+                argv = [g_proton.lib_dir + "/wine/x86_64-unix/wine64", g_proton.lib_dir + "/wine/x86_64-unix/wine", "c:\\windows\\system32\\steam.exe"]
             else:
                 argv = [g_proton.wine_bin, "c:\\windows\\system32\\steam.exe"]
 
