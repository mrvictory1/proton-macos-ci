

Date: Thu, 30 Jul 2026 13:05:08 +0300
Subject: [PATCH 28/42] Makefile.in: compile 32 and 64-bit wine at the same
 time (to enable WoW64)

---
 Makefile.in | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/Makefile.in b/Makefile.in
index e438db81..f6b121f7 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -588,6 +588,13 @@ $(eval $(call rules-cmake,vosk,aarch64,unix))
 ## wine
 ##
 
+# macOS builds only 64-bit wine with WoW64. Not building 32-bit wine
+# means from the perspective of make, wine no longer depends on 
+# 32-bit variants of dependencies. So such dependencies should be
+# manually specified.
+# wined3d.dll depends on vkd3d DLLs of same architecture. 
+$(OBJ)/.wine-x86_64-build: $(OBJ)/.vkd3d-i386-dist
+
 # HACK: glib 2.0 in the runtime is old and causes a lot of errors with a newer GCC
 WINE_CFLAGS += -Wno-discarded-qualifiers
 
@@ -619,8 +626,7 @@ WINE_AUTOCONF_ARGS = \
 # Removed due to heavy use of derprecated "sprintf" function.
 
 WINE_x86_64_AUTOCONF_ARGS = \
-  --enable-archs=$(call list-join,$(comma),x86_64 $(filter-out x86_64 $(unix_ARCHS),$(windows_ARCHS))) \
-  --enable-win64 \
+  --enable-archs=i386,x86_64 \
 
 WINE_aarch64_AUTOCONF_ARGS = \
   --enable-archs=$(call list-join,$(comma),arm64ec aarch64 $(filter-out arm64ec aarch64 $(unix_ARCHS),$(windows_ARCHS)))
@@ -643,10 +649,8 @@ WINE_aarch64_LIBDIR = $(WINE_aarch64_DST)/lib
 
 $(eval $(call rules-source,wine,$(SRCDIR)/wine))
 $(eval $(call rules-wine-requests,wine))
-$(eval $(call rules-wine-tools,wine,i386,unix))
 $(eval $(call rules-wine-tools,wine,x86_64,unix))
 $(eval $(call rules-wine-tools,wine,aarch64,unix))
-$(eval $(call rules-autoconf,wine,i386,unix))
 $(eval $(call rules-autoconf,wine,x86_64,unix))
 $(eval $(call rules-autoconf,wine,aarch64,unix))
 
-- 
