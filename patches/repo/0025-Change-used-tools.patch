From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mrvictory1 <108172910+mrvictory1@users.noreply.github.com>
Date: Thu, 30 Jul 2026 12:47:05 +0300
Subject: [PATCH 25/42] Change used tools.

Some tools are used either as-is or with the appropriate mingw prefix. Objcopy is modified to be either llvm-objcopy or mingw's objcopy, the right tool now determined by target OS.
---
 Makefile.in          |  7 +++++--
 default_pfx.py       |  3 ++-
 make/rules-common.mk | 30 ++++++++++++++++++++----------
 3 files changed, 27 insertions(+), 13 deletions(-)

diff --git a/Makefile.in b/Makefile.in
index 6f58814e..b3a1b1ab 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -98,15 +98,18 @@ ifeq ($(shell cc --version|grep 'clang'),)
 	TOOLCHAIN_PREFIX :=
 	OBJCOPY_FLAGS  := -p
 	MINGW_TYPE := gcc
+	OBJCOPY := objcopy
 else
 	# CLANG-specific flags
-	TOOLCHAIN_PREFIX := llvm-
+	# TOOLCHAIN_PREFIX := llvm-
 	OBJCOPY_FLAGS  :=
 	MINGW_TYPE := clang
+	OBJCOPY := llvm-objcopy
 	# TODO: move this to a configure option
 endif
 
-OBJCOPY := $(TOOLCHAIN_PREFIX)objcopy
+i386-unix_OBJCOPY := $(OBJCOPY)
+x86_64-unix_OBJCOPY := $(OBJCOPY)
 
 ifneq ($(UNSTRIPPED_BUILD),)
     STRIP :=
diff --git a/default_pfx.py b/default_pfx.py
index 62f1c16f..7d1944a3 100755
--- a/default_pfx.py
+++ b/default_pfx.py
@@ -122,7 +122,8 @@ def make_default_pfx(default_pfx_dir, dist_dir, arm64):
     libdir = dist_dir + '/lib/'
 
     system_libdir = ["/usr/aarch64-linux-gnu/lib"] if arm64 else []
-    ld_path = ':'.join([libdir + "x86_64-linux-gnu", libdir + "aarch64-linux-gnu", libdir + "i386-linux-gnu"] + system_libdir)
+#     ld_path = ':'.join([libdir + "x86_64-linux-gnu", libdir + "aarch64-linux-gnu", libdir + "i386-linux-gnu"] + system_libdir)
+    ld_path = ':'.join([libdir + "x86_64-apple-darwin", libdir + "i386-apple-darwin"] + system_libdir)
     local_env["LD_LIBRARY_PATH"] = ld_path
     local_env["WINEPREFIX"] = default_pfx_dir
     local_env["WINEDEBUG"] = "-all"
diff --git a/make/rules-common.mk b/make/rules-common.mk
index 6886a01a..899b0946 100644
--- a/make/rules-common.mk
+++ b/make/rules-common.mk
@@ -63,17 +63,17 @@ $$(OBJ)/.$(1)-$(3)-dist:
 ifneq ($(UNSTRIPPED_BUILD),)
 	cd $$($(2)_$(3)_LIBDIR) && find -type f -not '(' -iname '*.pc' -or -iname '*.cmake' -or -iname '*.a' -or -iname '*.la' -or -iname '*.def' -or -iname '*.h' ')' \
 	    -printf '--only-keep-debug\0%p\0$$(DST_LIBDIR)/%p.debug\0' | \
-	    xargs $(--verbose?) -0 -r -P$$(J) -n3 $(OBJCOPY) $(OBJCOPY_FLAGS)
+	    xargs $(--verbose?) -0 -r -P$$(J) -n3 $($(3)-$(4)_OBJCOPY) $(OBJCOPY_FLAGS)
 	cd $$($(2)_$(3)_LIBDIR) && find -type f -not '(' -iname '*.pc' -or -iname '*.cmake' -or -iname '*.a' -or -iname '*.la' -or -iname '*.def' -or -iname '*.h' ')' \
 	    -printf '--add-gnu-debuglink=$$(DST_LIBDIR)/%p.debug\0--strip-debug\0%p\0$$(DST_LIBDIR)/%p\0' | \
-	    xargs $(--verbose?) -0 -r -P$$(J) -n4 $(OBJCOPY) $(OBJCOPY_FLAGS)
+	    xargs $(--verbose?) -0 -r -P$$(J) -n4 $($(3)-$(4)_OBJCOPY) $(OBJCOPY_FLAGS)
 	touch $$@
 else
 	cd $$($(2)_$(3)_LIBDIR) && find -type f -not '(' -iname '*.pc' -or -iname '*.cmake' -or -iname '*.a' -or -iname '*.la' -or -iname '*.def' -or -iname '*.h' ')' \
 	    -printf '$$(DST_LIBDIR)/%p.debug\0' | xargs $(--verbose?) -0 -r -P$$(J) rm -f
 	cd $$($(2)_$(3)_LIBDIR) && find -type f -not '(' -iname '*.pc' -or -iname '*.cmake' -or -iname '*.a' -or -iname '*.la' -or -iname '*.def' -or -iname '*.h' ')' \
 	    -printf '--strip-debug\0%p\0$$(DST_LIBDIR)/%p\0' | \
-	    xargs $(--verbose?) -0 -r -P$$(J) -n3 $(OBJCOPY) $(OBJCOPY_FLAGS)
+	    xargs $(--verbose?) -0 -r -P$$(J) -n3 $($(3)-$(4)_OBJCOPY) $(OBJCOPY_FLAGS)
 	touch $$@
 endif
 
@@ -126,10 +126,10 @@ $(2)_$(3)_ENV = \
     $$(CARGO_LINKERS) \
     CCACHE_BASEDIR="$$(CCACHE_BASEDIR)" \
     STRIP="$$(STRIP)" \
-    AR="ar" \
-    RANLIB="ranlib" \
-    CC="cc" \
-    CXX="g++" \
+    AR="$$($(3)-$(4)_PREFIX)ar" \
+    RANLIB="$$($(3)-$(4)_PREFIX)ranlib" \
+    CC="$$($(3)-$(4)_PREFIX)gcc" \
+    CXX="$$($(3)-$(4)_PREFIX)g++" \
     LD="$$($(3)-$(4)_TARGET)-ld" \
     RC="$$($(3)-windows_TARGET)-windres" \
     WIDL="$$($(3)-windows_TARGET)-widl" \
@@ -182,10 +182,10 @@ endif
 endef
 
 ifneq ($(UNSTRIPPED_BUILD),)
-install-strip = $(OBJCOPY) $(OBJCOPY_FLAGS) --only-keep-debug $(1) $(2)/$(notdir $(1)).debug && \
-                $(OBJCOPY) $(OBJCOPY_FLAGS) --add-gnu-debuglink=$(2)/$(notdir $(1)).debug --strip-debug $(1) $(2)/$(notdir $(1))
+install-strip = $($(3)-$(4)_OBJCOPY) --only-keep-debug $(1) $(2)/$(notdir $(1)).debug && \
+                $($(3)-$(4)_OBJCOPY) --add-gnu-debuglink=$(2)/$(notdir $(1)).debug --strip-debug $(1) $(2)/$(notdir $(1))
 else
-install-strip = $(OBJCOPY) $(OBJCOPY_FLAGS) --strip-debug $(1) $(2)/$(notdir $(1)) && rm -f $(2)/$(notdir $(1)).debug
+install-strip = $($(3)-$(4)_OBJCOPY) $(OBJCOPY_FLAGS) --strip-debug $(1) $(2)/$(notdir $(1)) && rm -f $(2)/$(notdir $(1)).debug
 endif
 
 i386-unix_TARGET := i686-apple-darwin
@@ -204,6 +204,16 @@ x86_64-windows_LIBDIR := x86_64-w64-mingw32
 aarch64-windows_LIBDIR := aarch64-w64-mingw32
 arm64ec-windows_LIBDIR := arm64ec-w64-mingw32
 
+i386-windows_PREFIX := i686-w64-mingw32-
+x86_64-windows_PREFIX := x86_64-w64-mingw32-
+aarch64-windows_PREFIX := aarch64-w64-mingw32-
+arm64ec-windows_PREFIX := arm64ec-w64-mingw32-
+
+i386-windows_OBJCOPY := i686-w64-mingw32-objcopy
+x86_64-windows_OBJCOPY := x86_64-w64-mingw32-objcopy
+# i386-unix_OBJCOPY := $(OBJCOPY)
+# x86_64-unix_OBJCOPY := $(OBJCOPY)
+
 $(OBJ)/.%-i386-post-build:
 	touch $@
 $(OBJ)/.%-x86_64-post-build:
-- 
2.50.1 (Apple Git-155)

