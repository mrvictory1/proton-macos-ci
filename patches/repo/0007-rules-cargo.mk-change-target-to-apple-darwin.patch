

Date: Tue, 14 Jul 2026 10:24:09 +0300
Subject: [PATCH 07/42] rules-cargo.mk: change target to apple-darwin

---
 make/rules-cargo.mk | 6 +++---
 make/rules-meson.mk | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/make/rules-cargo.mk b/make/rules-cargo.mk
index 056a306b..776fb915 100644
--- a/make/rules-cargo.mk
+++ b/make/rules-cargo.mk
@@ -27,9 +27,9 @@ endef
 
 rules-cargo = $(call create-rules-cargo,$(1),$(call toupper,$(1)),$(2),$(3))
 
-i386-unix_CARGO_TARGET := i686-unknown-linux-gnu
-x86_64-unix_CARGO_TARGET := x86_64-unknown-linux-gnu
-aarch64-unix_CARGO_TARGET := aarch64-unknown-linux-gnu
+i386-unix_CARGO_TARGET := i686-apple-darwin
+x86_64-unix_CARGO_TARGET := x86_64-apple-darwin
+aarch64-unix_CARGO_TARGET := aarch64-apple-darwin
 
 i386-unix_CARGO_ARGS := --target $(i386-unix_CARGO_TARGET)
 x86_64-unix_CARGO_ARGS := --target $(x86_64-unix_CARGO_TARGET)
diff --git a/make/rules-meson.mk b/make/rules-meson.mk
index 8bde3327..6a5de7e4 100644
--- a/make/rules-meson.mk
+++ b/make/rules-meson.mk
@@ -71,7 +71,7 @@ x86_64_MESON_CPU := x86_64
 aarch64_MESON_CPU := aarch64
 arm64ec_MESON_CPU := aarch64
 
-unix_MESON_SYSTEM := apple
+unix_MESON_SYSTEM := darwin
 windows_MESON_SYSTEM := windows
 
 rules-meson = $(call create-rules-meson,$(1),$(call toupper,$(1)),$(2),$(3))
-- 
2.50.1 (Apple Git-155)

