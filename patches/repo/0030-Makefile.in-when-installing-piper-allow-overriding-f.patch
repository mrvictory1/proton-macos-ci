

Date: Thu, 30 Jul 2026 13:13:24 +0300
Subject: [PATCH 30/42] Makefile.in: when installing piper, allow overriding
 files and copy only .dylib files

---
 Makefile.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile.in b/Makefile.in
index cefcbb56..d02c796b 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -479,7 +479,7 @@ $(eval $(call rules-cmake,piper,aarch64,unix))
 
 $(OBJ)/.piper-x86_64-post-build:
 	mkdir -p $(PIPER_x86_64_DST)/lib/$(x86_64-unix_TARGET)
-	mv $(PIPER_x86_64_DST)/*.dylib* $(PIPER_x86_64_DST)/lib/$(x86_64-unix_TARGET)
+	mv -f $(PIPER_x86_64_DST)/*.dylib $(PIPER_x86_64_DST)/lib/$(x86_64-unix_TARGET)
 	mkdir -p $(DST_DIR)/share
 	cp -a $(PIPER_x86_64_DST)/{espeak-ng-data,libtashkeel_model.ort} $(DST_DIR)/share/
 	touch $@
-- 
