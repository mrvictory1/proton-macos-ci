From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mrvictory1 <108172910+mrvictory1@users.noreply.github.com>
Date: Thu, 30 Jul 2026 13:10:12 +0300
Subject: [PATCH 29/42] Makefile.in: specify arch and OS when calling
 install-strip

---
 Makefile.in | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/Makefile.in b/Makefile.in
index f6b121f7..cefcbb56 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -663,11 +663,11 @@ $(OBJ)/.wine-post-source:
 
 $(OBJ)/.wine-x86_64-post-build:
 	mkdir -p $(DST_DIR)/bin
-	$(call install-strip,$(WINE_x86_64_DST)/bin/wine,$(DST_DIR)/bin)
-	$(call install-strip,$(WINE_x86_64_DST)/bin/wineserver,$(DST_DIR)/bin)
+	$(call install-strip,$(WINE_x86_64_DST)/bin/wine,$(DST_DIR)/bin,x86_64,unix)
+	$(call install-strip,$(WINE_x86_64_DST)/bin/wineserver,$(DST_DIR)/bin,x86_64,unix)
 	mkdir -p $(DST_DIR)/lib/wine/i386-unix
-	$(call install-strip,$(WINE_x86_64_DST)/lib/wine/x86_64-unix/wine64,$(DST_DIR)/lib/wine/i386-unix)
-	$(call install-strip,$(WINE_x86_64_DST)/lib/wine/x86_64-unix/wine64-preloader,$(DST_DIR)/lib/wine/i386-unix)
+	$(call install-strip,$(WINE_x86_64_DST)/lib/wine/x86_64-unix/wine64,$(DST_DIR)/lib/wine/i386-unix,i386,unix)
+	$(call install-strip,$(WINE_x86_64_DST)/lib/wine/x86_64-unix/wine64-preloader,$(DST_DIR)/lib/wine/i386-unix,i386,unix)
 	cp -a $(WINE_x86_64_DST)/bin/msidb $(DST_DIR)/bin/
 
 	mkdir -p $(DST_DIR)/share
@@ -804,9 +804,9 @@ $(OBJ)/.vkd3d-x86_64-post-build: $(OBJ)/.wine-$(HOST_ARCH)-tools
 
 $(OBJ)/.vkd3d-i386-post-build: $(OBJ)/.wine-$(HOST_ARCH)-tools
 	mkdir -p $(VKD3D_i386_LIBDIR)/vkd3d/i386-windows
-	$(call make-builtin,$(VKD3D_i386_DST)/bin/libvkd3d-1.dll)
-	$(call make-builtin,$(VKD3D_i386_DST)/bin/libvkd3d-shader-1.dll)
-	$(call make-builtin,$(VKD3D_i386_DST)/bin/libvkd3d-utils-1.dll)
+	$(call make-builtin,$(VKD3D_i386_DST)/bin/libvkd3d-1.dll,VKD3D,i386)
+	$(call make-builtin,$(VKD3D_i386_DST)/bin/libvkd3d-shader-1.dll,VKD3D,i386)
+	$(call make-builtin,$(VKD3D_i386_DST)/bin/libvkd3d-utils-1.dll,VKD3D,i386)
 	cp $(VKD3D_i386_DST)/bin/libvkd3d-1.dll $(VKD3D_i386_LIBDIR)/vkd3d/i386-windows
 	cp $(VKD3D_i386_DST)/bin/libvkd3d-shader-1.dll $(VKD3D_i386_LIBDIR)/vkd3d/i386-windows
 	cp $(VKD3D_i386_DST)/bin/libvkd3d-utils-1.dll $(VKD3D_i386_LIBDIR)/vkd3d/i386-windows
-- 
